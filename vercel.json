{
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
