{
  "expo": {
    "name": "Spotted",
    "slug": "spotted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotted",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#110a24",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.janereynolds.spotted",
      "infoPlist": {
        "TSLocationManagerLicense": "eyJhbGciOiJFZERTQSIsImtpZCI6ImVkMjU1MTktbWFpbi12MSJ9..SQK8lO2GLpxyKEo5cgRpoJSn5-FEgjtCeTGqLHh1T7Zmrp7fcZVInuwWJk_bZQ3o6Q27z6l4aodSEZ7oGaRVCQ",
        "NSLocationWhenInUseUsageDescription": "Spotted uses your location to show which friends are nearby and detect when you arrive at venues.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spotted uses background location to notify you when friends arrive at venues and auto-detect your check-ins, even when the app is closed. Your location is only shared with friends you choose.",
        "NSMotionUsageDescription": "Spotted uses motion detection to save battery while tracking your venue.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.janereynolds.spotted"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110a24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-background-geolocation",
      "react-native-background-fetch",
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotted lets you share photos from your library in your posts.",
          "cameraPermission": "Spotted uses the camera so you can capture and share moments from your night."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
