{
  "expo": {
    "name": "Spotted",
    "slug": "spotted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotted",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#110a24",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.janereynolds.spotted",
      "buildNumber": "46",
      "infoPlist": {
        "TSLocationManagerLicense": "eyJhbGciOiJFZERTQSIsImtpZCI6ImVkMjU1MTktbWFpbi12MSJ9..SQK8lO2GLpxyKEo5cgRpoJSn5-FEgjtCeTGqLHh1T7Zmrp7fcZVInuwWJk_bZQ3o6Q27z6l4aodSEZ7oGaRVCQ",
        "NSLocationWhenInUseUsageDescription": "Spotted uses your location to show which friends are nearby and detect when you arrive at venues.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spotted uses background location to notify you when friends arrive at venues and auto-detect your check-ins, even when the app is closed. Your location is only shared with friends you choose.",
        "NSMotionUsageDescription": "Spotted uses motion detection to save battery while tracking your venue.",
        "NSCameraUsageDescription": "Spotted uses the camera so you can capture and share moments from your night.",
        "NSMicrophoneUsageDescription": "Spotted uses the microphone to record sound in your videos. Without it, videos are silent.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.transistorsoft.fetch",
          "com.transistorsoft.customtask"
        ]
      },
      "appleTeamId": "WAG8BQTW69"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.janereynolds.spotted",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110a24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-background-geolocation",
      "react-native-background-fetch",
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Spotted shows your latest photo as a shortcut to your library. Photos you don't share never leave your device.",
          "savePhotosPermission": "Spotted can save captured photos and videos to your library."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotted lets you share photos from your library in your posts.",
          "cameraPermission": "Spotted uses the camera so you can capture and share moments from your night."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Spotted matches your contacts to find friends already on the app. Numbers are never stored."
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
